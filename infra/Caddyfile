# Proxy com SSL automático.
# - O Admin e a API ficam no domínio da plataforma (ADMIN_DOMAIN).
# - Qualquer outro domínio é um site de ginásio: o certificado é emitido no primeiro acesso,
#   depois de o Django confirmar que o domínio pertence a um ginásio ativo (TLS on-demand).
{
	email {$ACME_EMAIL}
	on_demand_tls {
		ask http://backend:8000/internal/dominio-valido/
	}
}

{$ADMIN_DOMAIN} {
	encode zstd gzip
	@internos path /internal/* /api/v1/*
	respond @internos 404
	handle_path /media/* {
		root * /srv/media
		file_server
		header Cache-Control "public, max-age=31536000, immutable"
	}
	reverse_proxy backend:8000
}

https:// {
	tls {
		on_demand
	}
	encode zstd gzip
	reverse_proxy site:3100 {
		header_up X-Forwarded-Host {host}
	}
}

http:// {
	redir https://{host}{uri} permanent
}
